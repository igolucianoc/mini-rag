# Copie para .env e preencha. NUNCA commite o .env real.

# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados (aponta para o service "db" do docker-compose)
DATABASE_URL=postgresql://mini_rag:mini_rag@db:5432/mini_rag?schema=public

# Postgres (usados pelo service db do docker-compose)
POSTGRES_USER=mini_rag
POSTGRES_PASSWORD=mini_rag
POSTGRES_DB=mini_rag

# Autenticação (troque por segredos fortes)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Hugging Face (provider exclusivo de LLM/embeddings, via router de Inference Providers)
# HF_MODEL: modelo de chat servido pelo endpoint /v1/chat/completions do router.
# HF_EMBEDDING_MODEL: modelo de feature-extraction servido pelo provider hf-inference.
HF_TOKEN=your_hugging_face_token_here
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# CORS / frontend
WEB_ORIGIN=http://localhost:5173
